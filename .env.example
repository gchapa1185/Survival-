# Required: signs license tokens. Any random string, 16+ chars.
LICENSE_SECRET=change-me-to-a-long-random-string

# Stripe (payments). Without these, the app runs in free-preview mode only.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
PRICE_LABEL=$9/month

# Claude API (AI-tailored seasons for paying users). Optional; falls back to templates.
ANTHROPIC_API_KEY=sk-ant-...
# EPISODIC_MODEL=claude-opus-5-5

# Public URL used for Stripe redirects, e.g. https://episodic.app
PUBLIC_URL=http://localhost:3000
PORT=3000
